# Copie para .env.local. NUNCA commite valores reais.
# Somente chave PÚBLICA (publishable/anon): a segurança está no RLS e nas funções do banco.
# O site não usa service role nem guarda segredos de assinatura (ficam no banco).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000
# Com código de país, sem + (ex.: 5219981234567)
WHATSAPP_NUMBER=

# Somente em produção (docker compose): domínio público, sem https://
DOMAIN=
